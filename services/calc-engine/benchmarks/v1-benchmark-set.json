{
  "version": "1.0.0",
  "description": "Rysnova 智设 · 精算基准集 v1（≥5 典型户型/场景，含手算对照）。用于验证 calc-engine 输出量级与稳态手算一致，并在 hvacpy 不可用时作为内置 screening 的校准锚点。",
  "method": "steady-state hand-check (envelope + ventilation + internal gains)",
  "references": [
    "ASHRAE Fundamentals 2021, Ch.18 Heating & Ch.28 Cooling Load",
    "GB 50736-2012 民用建筑供暖通风与空气调节设计规范",
    "GB 50019-2015 工业建筑供暖通风与空气调节设计规范"
  ],
  "cases": [
    {
      "id": "res-shanghai-100",
      "name": "上海三居公寓",
      "area_m2": 100,
      "ceiling_height_m": 2.8,
      "city": "shanghai",
      "building_type": "residential",
      "occupants": 3,
      "bathrooms": 2,
      "orientation": "南北通透",
      "hand_check": {
        "indoor_heating_c": 20,
        "indoor_cooling_c": 26,
        "outdoor_winter_c": -2,
        "outdoor_summer_c": 35,
        "u_avg_w_m2k": 1.1,
        "shell_factor": 2.6,
        "equip_lighting_w_m2": 15,
        "base_ach": 0.5,
        "occ_sensible_w": 110,
        "vent_per_person_m3h": 30,
        "steps": {
          "heating_envelope_kw": "1.1 * 100 * 2.6 * (20 - (-2)) / 1000 = 6.29",
          "heating_ventilation_kw": "0.34 * max(3*30, 100*2.8*0.5) * 22 / 1000 = 0.75",
          "heating_total_kw": "6.29 + 0.75 = 7.04",
          "cooling_envelope_kw": "1.1 * 100 * 2.6 * (35 - 26) / 1000 = 2.57",
          "cooling_ventilation_kw": "0.34 * max(90, 140) * 9 / 1000 = 0.43",
          "cooling_internal_kw": "3 * 110 + 100 * 15 / 1000 = 1.83",
          "cooling_total_kw": "2.57 + 0.43 + 1.83 = 4.83"
        },
        "expected_cooling_load_kw": 4.8,
        "expected_heating_load_kw": 7.0,
        "expected_intensity_w_m2": { "cooling": 48, "heating": 70 }
      },
      "tolerance_percent": 15
    },
    {
      "id": "res-beijing-80",
