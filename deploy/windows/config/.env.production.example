NODE_ENV=production
HOST=127.0.0.1
PORT=4500
API_PORT=4500

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-application-password
POSTGRES_DB=rhautt_nexus
POSTGRES_SCHEMA=rhautt_nexus
POSTGRES_SYNCHRONIZE=false

JWT_SECRET=replace-with-at-least-32-random-bytes
PHONE_HASH_SECRET=replace-with-at-least-32-random-bytes
PII_ENCRYPTION_KEY=replace-with-the-existing-production-key

# Rhautt Nexus SSO OIDC production client.
# OIDC_CLIENT_SECRET must be injected on the server only; leave blank in templates.
OIDC_ISSUER=https://ai.rhautt.com
OIDC_CLIENT_ID=cli_mrve0bgvgnl2gkjg
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://nexus.rhautt.com/api/v2/auth/sso/callback
OIDC_SCOPES=openid profile email roles org
OIDC_POST_LOGIN_REDIRECT=/brand
OIDC_USERINFO_ENABLED=true
OIDC_ALLOWED_REDIRECT_HOSTS=nexus.rhautt.com
OIDC_ROLES_CLAIM=roles
OIDC_ORG_CLAIM=org
OIDC_AUTO_PROVISION_ENABLED=false
OIDC_AUTO_PROVISION_ALLOWED_EMAIL_DOMAINS=rhenext.com
OIDC_AUTO_PROVISION_TENANT_CODE=DEFAULT
OIDC_AUTO_PROVISION_ROLE_MAP=owner:platform_admin,admin:platform_admin,employee:hq_admin
OIDC_AUTO_PROVISION_DEFAULT_ROLE=hq_admin

EVERHOT_TENANT_ID=e5e40000-0000-4000-8000-000000000001
BRAND_TENANT=e5e40000-0000-4000-8000-000000000001
BRAND=everhot
NEXUS_API_URL=http://127.0.0.1:4500
NEXUS_API_PREFIX=/api/v2

STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=storage
BRAND_REGISTRY_PATH=brand-registry.json
RYSNOVA_CASES_FILE=content/rysnova-cases.json

# Optional. Leave unset when Redis is not installed on this server.
# REDIS_URL=redis://:replace-with-password@127.0.0.1:6379/0
