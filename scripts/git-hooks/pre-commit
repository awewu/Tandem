#!/bin/sh
# Tandem pre-commit gate — 防止退化提交（4 条铁律的工程层兜底）
# 安装: bash scripts/setup-git-hooks.sh
# 跳过: 临时 git commit --no-verify（须在 commit message 说明理由）
#
# 覆盖三个 TS 工程 + 砍页护栏 + 对外品牌 VI 合规。
# （历史 step3 的 scripts/check-ui-charter.mjs 已随文档清理下线；改用现存的
#  guard:rheem-vi-production 承接对外 VI 合规，避免引用已删脚本导致钩子恒失败。）

echo "🔒 Tandem pre-commit gate · 检查中..."

fail=0

run_tsc() {
  label="$1"; shift
  out=$(npx tsc --noEmit "$@" 2>&1)
  n=$(printf "%s" "$out" | grep -c "error TS")
  if [ "$n" -gt 0 ]; then
    echo "  ❌ [$label] tsc found $n error(s):"
    printf "%s\n" "$out" | grep -E "error TS" | head -15
    fail=1
  else
    echo "  ✓ [$label] tsc clean"
  fi
}

echo "  [1/3] TypeScript --noEmit（root + services/api + dealer-workbench）..."
rm -f tsconfig.tsbuildinfo
run_tsc "root"           # 根 tsconfig（legacy server/ + src/）
run_tsc "api"    -p services/api/tsconfig.json
run_tsc "workbench" -p apps/dealer-workbench/tsconfig.json
if [ "$fail" -ne 0 ]; then
  echo "     修完再 commit（强制: git commit --no-verify + 在 message 说明）"
  exit 1
fi

echo "  [2/3] 检查 redirect-only 砍页（新增 page.tsx 仅含 redirect）..."
SUSPICIOUS=$(git diff --cached --name-only --diff-filter=A | grep "page\.tsx$" | xargs -I {} sh -c 'lines=$(wc -l < "{}" 2>/dev/null || echo 0); if [ "$lines" -lt 20 ] && grep -q "redirect" "{}"; then echo "{}"; fi' 2>/dev/null)
if [ -n "$SUSPICIOUS" ]; then
  echo "  ⚠ 新增 redirect-only 短文件（疑似砍页）:"
  echo "$SUSPICIOUS"
  echo "     确认非误删业务页后 git commit --no-verify（并在 message 写明为什么删）"
  exit 1
fi
echo "  ✓ 无可疑砍页"

echo "  [3/3] 对外品牌 VI 合规（guard:rheem-vi-production）..."
npm run guard:rheem-vi-production > /dev/null 2>&1
if [ "$?" -ne 0 ]; then
  echo "  ❌ 对外品牌 VI 合规未过（详情: npm run guard:rheem-vi-production）"
  echo "     （强制: git commit --no-verify + commit msg 说明）"
  exit 1
fi
echo "  ✓ VI 合规通过"

echo "🟢 pre-commit 通过"
exit 0
