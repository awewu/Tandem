# ============================================================
# Tandem · 生产环境变量 (.env.production)
# ============================================================
# 用法:
#   cp .env.production.example .env.production
#   # 把所有 CHANGE_ME 改成强随机值 (推荐: openssl rand -hex 32)
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# 严禁:
#   - 把这个文件提交到 git (已经在 .gitignore)
#   - 使用占位密码 / 弱密码 (production-guard.ts 会拒绝启动)
# ============================================================

# ───── App ─────
NODE_ENV=production
APP_PORT=3000
LOG_LEVEL=info
NEXTAUTH_URL=https://your-domain.example.com         # 必须是真实部署域名 (用于回调 / cookie domain)

# ───── PostgreSQL ─────
POSTGRES_USER=tandem
POSTGRES_PASSWORD=CHANGE_ME_postgres_strong_password_32_chars
POSTGRES_DB=tandem
# DATABASE_URL compose 会自动从上面三个拼出来; 这里仅用于本地 db:migrate / db:studio
DATABASE_URL=postgresql://tandem:CHANGE_ME_postgres_strong_password_32_chars@postgres:5432/tandem
# 搭子手抄独立库。配置后 Tandem 内的 /shouchao 入口仍保留, 但手抄数据读写切到此库。
SHOUCHAO_DATABASE_URL=postgresql://shouchao:CHANGE_ME_shouchao_postgres_strong_password_32_chars@postgres:5432/shouchao
# Tandem 后台蒸馏任务读取全量手抄数据的内部令牌。
SHOUCHAO_INTERNAL_TOKEN=CHANGE_ME_shouchao_internal_token_64_hex_chars_min
SHOUCHAO_MOBILE_SERVER_URL=https://shouchao.your-domain.example.com

# ───── 法务文档 / APP 上架必备 ─────
# 隐私政策默认在牛马搭子 Web 管理后台 /admin/legal 编辑并保存到数据库。
# 下面两个变量仅作为外部 Markdown 兜底, 正常使用可以留空。
PRIVACY_POLICY_SOURCE_URL=
PRIVACY_POLICY_SOURCE_TIMEOUT_MS=5000

# ───── Redis (session, rate-limit, cache) ─────
REDIS_PASSWORD=CHANGE_ME_redis_strong_password_32_chars

# ───── MinIO / S3 (Drive 文件) ─────
MINIO_ROOT_USER=tandem
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_strong_password_32_chars
S3_BUCKET_DRIVE=tandem-drive
S3_BUCKET_ATTACHMENTS=tandem-attachments
S3_BUCKET_SHOUCHAO_ATTACHMENTS=shouchao-attachments

# ───── 语音转写 (Tandem 手抄 / 独立搭子手抄 APP / DashScope 千问 ASR) ─────
STT_PROVIDER=dashscope
STT_MODEL=qwen3-asr-flash
STT_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
STT_API_KEY=CHANGE_ME_stt_api_key
OCR_PROVIDER=openai
OCR_MODEL=qwen-vl-ocr
OCR_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# 可留空复用 QWEN_API_KEY; 若拍照记使用独立 Key, 在这里配置。
OCR_API_KEY=

# ───── Auth secrets (生产必须强随机) ─────
# 生成: openssl rand -hex 32
NEXTAUTH_SECRET=CHANGE_ME_nextauth_secret_64_hex_chars_min
SESSION_SECRET=CHANGE_ME_session_secret_64_hex_chars_min

# 接口日志。建议与会话密钥分离, 两项均使用强随机值。
API_LOG_INGEST_SECRET=CHANGE_ME_api_log_ingest_secret_64_hex_chars_min
API_LOG_IP_SALT=CHANGE_ME_api_log_ip_salt_64_hex_chars_min
API_LOG_BODY_MAX_BYTES=32768
API_LOG_MEMORY_MAX=5000
# 业务日志内存回退上限
BUSINESS_LOG_MEMORY_MAX=5000
MFA_ENCRYPTION_KEY=CHANGE_ME_mfa_encryption_key_64_hex_chars_min

ACCESS_TOKEN_TTL_SEC=900
SESSION_TTL_SEC=604800
BCRYPT_ROUNDS=12

# ───── Demo bypass (生产必须 0) ─────
ALLOW_DEMO_AUTH=0

# ───── 首次启动自动建 Owner 账号 ─────
# 第一次容器起来时, bootstrapOwnerIfMissing() 会用这两个变量建 owner.
# 启动后建议立刻: 1) 登录改密  2) 启用 MFA  3) 设置 ALLOW_DEMO_AUTH=0
TANDEM_BOOTSTRAP_OWNER_EMAIL=admin@your-domain.example.com
TANDEM_BOOTSTRAP_OWNER_PASSWORD=CHANGE_ME_first_admin_strong_password_18_chars
TANDEM_BOOTSTRAP_OWNER_NAME=Tandem Owner

# ───── Rate limiting ─────
RATE_LIMIT_LOGIN_PER_HOUR=5
RATE_LIMIT_API_PER_MINUTE=120

# ───── LLM Providers (至少配一个, 否则 AI 功能降级) ─────
# DeepSeek (主力, 性价比高, 国内可达)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Claude (可选, 长文/推理强)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI (可选)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ───── 用友 ERP / iuap OpenAPI access_token ─────
# YONYOU_ERP_BASE_URL 使用租户所在数据中心域名，例如 https://c1.yonyoucloud.com
YONYOU_ERP_BASE_URL=
YONYOU_ERP_APP_KEY=
YONYOU_ERP_APP_SECRET=
YONYOU_ERP_TOKEN_PATH=/iuap-api-auth/open-auth/selfAppAuth/base/v1/getAccessToken
YONYOU_ERP_TOKEN_TIMEOUT_MS=8000
YONYOU_ERP_THIRD_UC_ID=
YONYOU_ERP_TENANT_ID=
YONYOU_ERP_SSO_BASE_URL=https://euc.yonyoucloud.com
# 文档示例为 https://{data-center}/login?tenantId={tenantId}；配置 YONYOU_ERP_TENANT_ID 后会自动生成
YONYOU_ERP_LOGIN_SERVICE=
YONYOU_ERP_SSO_LOGIN_PATH=/cas/thirdOauth2CodeLogin
YONYOU_ERP_SSO_CODE_PATH=/iuap-api-gateway/yonbip/yht/getThirdLoginCode
YONYOU_ERP_SSO_TIMEOUT_MS=8000

# ───── 监控 (可选) ─────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
