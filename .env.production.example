# Rhautt Nexus · 生产环境变量样例（复制为 .env.production 并注入真实值；切勿提交真实密钥）
# 启动前跑 `npm run preflight`（生产缺项/dev默认会拒启）。

# ── 运行环境 ─────────────────────────────────────────────
NODE_ENV=production
PORT=5500
HOST=0.0.0.0
# API_BODY_LIMIT_BYTES=52428800

# ── 数据库（运行时必须用最小权限 rhautt_app · NOSUPERUSER/NOBYPASSRLS；迁移用属主 rhautt）──
POSTGRES_HOST=__DB_HOST__
POSTGRES_PORT=5432
POSTGRES_USER=rhautt_app
POSTGRES_PASSWORD=__STRONG_DB_PASSWORD__
POSTGRES_DB=rhautt_nexus
POSTGRES_SCHEMA=rhautt_nexus
# 或整体连接串（优先）：POSTGRES_URI=postgres://rhautt_app:__PWD__@__HOST__:5432/rhautt_nexus
# 生产禁用 TypeORM 同步（schema 由 curated 迁移拥有）：
POSTGRES_SYNCHRONIZE=false

# ── 安全密钥（强随机；用 `openssl rand -hex 32` 生成）─────────
JWT_SECRET=__RANDOM_32B_HEX__
# PII 加密（PIPL 必需；32 字节 = 64 位 hex 或 base64 编码的 32 字节）
PII_ENCRYPTION_KEY=__RANDOM_32B_HEX__
PII_HASH_SALT=__RANDOM_SALT__

# ── 多租户 outbox 枚举（每个运营租户一行 <SLUG>_TENANT_ID；缺失则飞轮卡 pending）──
NEXUS_TENANT_ID=__TENANT_UUID__
# EVERHOT_TENANT_ID=__TENANT_UUID__
# 其余运营租户按需追加：<SLUG>_TENANT_ID=...

# ── 缓存 / 事件总线（Redis Streams 消费组）──────────────────
REDIS_URL=redis://__REDIS_HOST__:6379
# REDIS_USERNAME=
# REDIS_PASSWORD=

# ── AI provider（缺则 AgenticGEO/内容生成走确定性兜底，非真模型）──
# 方案一：Anthropic 直连
# ANTHROPIC_API_KEY=__KEY__
# GROWTH_AI_MODEL=claude-3-5-sonnet-latest
# 方案二：中台 AI 网关（Tandem 治理）
# HERMES_CENTER_AI_BASE_URL=https://ai.rhautt.com
# HERMES_CENTER_AI_PROVIDER=qwen-max
# HERMES_CENTER_AI_AUTH_HEADER=authorization
# HERMES_CENTER_AI_AUTH_TOKEN=__TOKEN__

# ── SSO / OIDC（生产自动开通，切勿开 dev 开关）──────────────
# OIDC_AUTO_PROVISION_ENABLED=true
# OIDC_AUTO_PROVISION_TENANT_ID=__TENANT_UUID__
# OIDC_AUTO_PROVISION_ALLOWED_EMAIL_DOMAINS=rhautt.com
# 禁止：NEXUS_DEV_SSO / OIDC_DEV_AUTO_PROVISION_*（生产 preflight 会拒）

# ── 业务阈值（基座3 毛利闸）──────────────────────────────
# PRICING_MARGIN_FLOOR=0.15
# REBATE_MARGIN_FLOOR=0.05

# ── 可观测性 ────────────────────────────────────────────
# OBSERVABILITY_LOG_REQUESTS=false
# OBSERVABILITY_SLOW_MS=1000
# SENTRY_DSN=__DSN__   （接入后 setErrorSink 注入 @sentry/node）
