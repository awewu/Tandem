# 生产跨子域 SSO —— 各前端应用注入（部署平台环境变量）。
# 关键：父域 cookie 使所有 *.rhautt.com 子域共享 nx_token 登录态。
NEXT_PUBLIC_COOKIE_DOMAIN=.rhautt.com
NEXT_PUBLIC_COOKIE_SECURE=true

# 跨应用外链（生产真实域名）
NEXT_PUBLIC_PORTAL_URL=https://portal.rhautt.com
NEXT_PUBLIC_DEALER_URL=https://dealer.rhautt.com
NEXT_PUBLIC_DESIGN_URL=https://design.rhautt.com
NEXT_PUBLIC_CONSOLE_URL=https://console.rhautt.com
NEXT_PUBLIC_DIAGNOSIS_URL=https://rysnova.com.cn
NEXT_PUBLIC_LOGIN_URL=https://dealer.rhautt.com

# 后端（反向代理同源到 NestJS；如分离则填绝对地址）
NEXT_PUBLIC_API_URL=

# Rhautt Nexus SSO OIDC server runtime.
# Keep OIDC_CLIENT_SECRET out of git; inject it through the production secret manager.
OIDC_ISSUER=https://ai.rhautt.com
OIDC_CLIENT_ID=cli_mrve0bgvgnl2gkjg
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://nexus.rhautt.com/api/v2/auth/sso/callback
OIDC_SCOPES=openid profile email roles org
# /hub is the Nexus business landing page after login, not the OIDC callback URL.
OIDC_POST_LOGIN_REDIRECT=/hub
OIDC_USERINFO_ENABLED=true
OIDC_ALLOWED_REDIRECT_HOSTS=nexus.rhautt.com
OIDC_ROLES_CLAIM=roles
OIDC_ORG_CLAIM=org

# ── 后端真相源（server-production.js / server/index.js 用）──
# 生产 /api/v2 默认全量反代到 NestJS。NESTJS_URL 指向 NestJS 服务地址。
NESTJS_URL=http://localhost:3300
# 紧急回退开关：=true 时未迁移域改走本地冻结 Express v2（默认 false，勿在生产开启）。
LEGACY_V2_INPROCESS=false
