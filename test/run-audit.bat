@echo off
chcp 65001 >nul
echo ============================================================
echo 🔍 瑞美极致系统 - 全量自检工具
echo ============================================================
echo.
echo 功能:
echo   - 检查所有核心引擎文件
echo   - 验证语法正确性
echo   - 检查模块导出
echo   - 验证API路由注册
echo   - 测试运行时加载
echo.
echo ============================================================
echo.

cd /d "%~dp0"

node system-audit.js

echo.
echo ============================================================

if %ERRORLEVEL% NEQ 0 (
    echo.
    echo ⚠️  自检发现问题！请查看上方错误信息
    echo 📄 详细报告: system-audit-report.json
) else (
    echo.
    echo ✅ 全量自检通过！系统状态良好
)

echo ============================================================
pause
