{
  "name": "hermes-agent-webui",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NEXT_DIST_DIR=.next-dev DISABLE_DEMO_SEED=1 next dev -p 3005",
    "dev:ready": "node scripts/dev-ready.mjs",
    "dev:fast": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-dev-fast.ps1",
    "dev:lan": "cross-env NEXT_DIST_DIR=.next-dev DISABLE_DEMO_SEED=1 next dev -H 0.0.0.0 -p 3005",
    "dev:poll": "cross-env NEXT_DIST_DIR=.next-dev DISABLE_DEMO_SEED=1 NEXT_WEBPACK_POLL=1 next dev -p 3005",
    "dev:clean": "node scripts/clean-dev-cache.mjs",
    "dev:warm": "node scripts/warmup.mjs",
    "dev:warm:full": "cross-env WARMUP_MODE=full node scripts/warmup.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:ui-charter": "node scripts/check-ui-charter.mjs",
    "lint:ui-charter:strict": "node scripts/check-ui-charter.mjs --strict",
    "audit:raw-palette": "node scripts/audit-raw-palette.mjs",
    "lint:dead-code": "node scripts/scan-unused.mjs",
    "lint:dead-code:strict": "node scripts/scan-unused.mjs --strict",
    "check:api-logs": "node scripts/business-log-routes.mjs check",
    "check:backlog-drift": "node scripts/check-backlog-drift.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pms-integration": "vitest run --config vitest.integration.config.ts",
    "test:ui": "vitest --ui",
    "evals": "vitest run tests/eval --reporter=verbose",
    "brain:smoke": "node scripts/brain-smoke.mjs",
    "brain:load": "node scripts/brain-load.mjs",
    "evals:online": "node scripts/run-evals.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "yjs:server": "node scripts/yjs-server.mjs",
    "build:static": "node scripts/build-static.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/gen-updater-config.mjs && tauri build --config src-tauri/gen/updater.conf.json",
    "tauri:build:raw": "tauri build",
    "mobile:bootstrap": "node scripts/build-mobile-bootstrap.mjs",
    "mobile:copy": "node scripts/build-mobile-bootstrap.mjs && npx cap copy",
    "mobile:sync": "node scripts/build-mobile-bootstrap.mjs && npx cap sync",
    "mobile:dev": "cross-env TANDEM_MOBILE_SERVER_URL=http://10.0.2.2:3005 node scripts/build-mobile-bootstrap.mjs && cross-env TANDEM_MOBILE_SERVER_URL=http://10.0.2.2:3005 npx cap run android",
    "mobile:android:lan": "powershell -ExecutionPolicy Bypass -File scripts/mobile-android-lan-debug.ps1",
    "mobile:build:android": "cross-env TANDEM_MOBILE_SERVER_URL=https://ai.rhautt.com node scripts/build-mobile-bootstrap.mjs && cross-env TANDEM_MOBILE_SERVER_URL=https://ai.rhautt.com npx cap build android",
    "mobile:open:android": "npx cap open android",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "pre-warm": "node scripts/pre-warm.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "db:push": "node -e \"console.error('db:push 已禁用: User 表残留 Prisma 遗留列, push 会误删真列。请用 scripts/apply-migration.mjs 幂等 DDL。'); process.exit(1)\"",
    "db:studio": "drizzle-kit studio",
    "db:seed:production": "node scripts/seed-production-kpis.mjs",
    "db:import:local": "node scripts/import-local-folder.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.4.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/status-bar": "^8.0.2",
    "@file-viewer/preset-office": "^2.2.4",
    "@file-viewer/react": "^2.2.4",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/canvas": "^0.1.100",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.1",
    "@types/dompurify": "^3.0.5",
    "@types/pg": "^8.20.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.12",
    "drizzle-orm": "^0.45.2",
    "imapflow": "^1.4.0",
    "ioredis": "^5.10.1",
    "jszip": "^3.10.1",
    "livekit-client": "^2.19.0",
    "livekit-server-sdk": "^2.15.3",
    "lucide-react": "^0.400.0",
    "mailparser": "^3.9.9",
    "mammoth": "^1.12.0",
    "next": "14.2.35",
    "nodemailer": "^8.0.7",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.5.0",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.3.0",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.30",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@playwright/test": "^1.60.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/ui": "^4.1.7",
    "autoprefixer": "^10.4.19",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vitest": "^4.1.7"
  }
}
