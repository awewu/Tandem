  },
  "build": {
    "appId": "com.rhautt.nexus",
    "productName": "Rhautt Nexus",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "server/**/*",
      "server-production.js",
      "public/**/*",
      "exports/**/*",
      "templates/**/*",
      "database/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public"
      },
      {
        "from": "server",
        "to": "server"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/images/rhenext-logo.png",
      "publisherName": "Rheem China",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/images/rhenext-logo.png",
      "uninstallerIcon": "public/images/rhenext-logo.png",
      "installerHeaderIcon": "public/images/rhenext-logo.png",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rhautt Nexus",
      "include": "build/installer.nsh",
      "license": "LICENSE.txt"
    },
    "portable": {
      "artifactName": "Rhautt-Nexus-portable-${version}-${arch}.${ext}"
    },
    "asar": true,
    "asarUnpack": [
      "server/**/*",
      "exports/**/*"
    ]
  }
}
