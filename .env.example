# ==============================================================
# 🔒 生产环境必设 (2026-04-22 P0/P1 审查加固)
# ==============================================================

# 运行环境: production 将启用: JWT_SECRET 强制校验 + 错误堆栈隐藏
NODE_ENV=production

# JWT 密钥 (必须在生产环境设置, 否则启动失败)
# 生成方式: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_ME_WITH_64_CHAR_RANDOM_STRING

# Rhautt Nexus SSO OIDC (server-side only; never expose client_secret to browser code)
OIDC_ISSUER=https://ai.rhautt.com
OIDC_CLIENT_ID=cli_mrvdz1yr8jfzrb8u
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5000/api/v2/auth/sso/callback
OIDC_SCOPES=openid profile email roles org
# /hub is the Nexus business landing page after login, not the OIDC callback URL.
OIDC_POST_LOGIN_REDIRECT=/hub
OIDC_USERINFO_ENABLED=true
OIDC_ALLOWED_REDIRECT_HOSTS=localhost:5000
OIDC_ROLES_CLAIM=roles
OIDC_ORG_CLAIM=org

# CORS 白名单 (多个逗号分隔, 不要写 *)
CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# 数据库模式 (true=MongoDB, false=JSON文件)
USE_MONGO=false

# MongoDB 连接 (USE_MONGO=true 时生效)
MONGODB_URI=mongodb://localhost:27017/rheem-platform

# 服务器端口
PORT=5000

# 前端URL
FRONTEND_URL=http://localhost:3000

# ==============================================================

# 短信服务配置（可选）
SMS_API_KEY=your-sms-api-key
SMS_API_SECRET=your-sms-api-secret

# 文件上传配置
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=50MB

# Redis配置（可选，用于缓存和会话）
REDIS_URL=redis://localhost:6379

# 邮件服务配置（可选）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password

# 日志配置
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# 静态资源访问控制（生产环境必需，保护 exports 目录的报告和图纸）
EXPORTS_ACCESS_KEY=your-random-access-key-here

# PII加密密钥（生产必需，用于手机号等敏感字段加密）
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PII_ENCRYPTION_KEY=REPLACE_ME_WITH_64_CHAR_RANDOM_STRING

# 手机号哈希密钥（生产必需，用于手机号去重查找）
PHONE_HASH_SECRET=REPLACE_ME_WITH_32_CHAR_RANDOM_STRING

# 强制要求 MongoDB（设为 true 可在非 production 环境也触发 fail-fast）
REQUIRE_MONGODB=false

# =========================================================
# 安全加固配置 (2026-04-24 安全审查新增)
# =========================================================
# 生产环境必须设置的密钥清单：
#   JWT_SECRET          身份认证
#   PII_ENCRYPTION_KEY  PII字段加密
#   PHONE_HASH_SECRET   手机号哈希
#   MONGODB_URI         数据库连接
#   CORS_ORIGINS        跨域白名单

# =========================================================
# 6大系统一键计算平台配置 (150人团队)
# =========================================================

# 计算引擎版本
CALC_ENGINE_VERSION=1.0.0
CALC_ENGINE_NAME=OneClickCalculationEngine

# 性能配置
CALC_MAX_CONCURRENT=50
CALC_TIMEOUT_MS=5000
CALC_CACHE_ENABLED=true

# 6大系统开关
ENABLE_HOTWATER=true
ENABLE_WATER=true
ENABLE_FRESHAIR=true
ENABLE_COOLING=true
ENABLE_DOAS=true
ENABLE_HEATING=true
ENABLE_CONTROL=true

# 数据库分片配置 (支持150人并发)
MONGODB_SHARD_URI=mongodb://localhost:27017/rheem-calc-shard

# Redis集群配置
REDIS_CLUSTER=true
REDIS_CLUSTER_NODES=localhost:7000,localhost:7001,localhost:7002

# 监控配置
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
JAEGER_ENABLED=true

# 部署配置
VERSION=1.0.0
DEPLOY_ENV=production
DOCKER_REGISTRY=rheem

# 150人团队CI/CD配置
CI_PIPELINE_ID=150-team
CI_MAX_PARALLEL_JOBS=20

# 安全加固
API_RATE_LIMIT_PER_MINUTE=1000
ENABLE_REQUEST_SIGNING=true
ENABLE_IP_WHITELIST=false

# =========================================================
# 测试账号配置 (开发环境使用)
# =========================================================
TEST_ACCOUNT_ADMIN_PHONE=13900000000
TEST_ACCOUNT_ADMIN_PASS_HASH=$2b$10$testhash
TEST_ACCOUNT_ADMIN_NAME=张店长

TEST_ACCOUNT_DESIGNER_PHONE=13800000000
TEST_ACCOUNT_DESIGNER_PASS_HASH=$2b$10$testhash
TEST_ACCOUNT_DESIGNER_NAME=李设计师

TEST_ACCOUNT_SALES_PHONE=13700000000
TEST_ACCOUNT_SALES_PASS_HASH=$2b$10$testhash
TEST_ACCOUNT_SALES_NAME=王销售

TEST_ACCOUNT_RHEEM_PHONE=13600000000
TEST_ACCOUNT_RHEEM_PASS_HASH=$2b$10$testhash
TEST_ACCOUNT_RHEEM_NAME=刘管理员

TEST_ACCOUNT_SUPER_PHONE=13500000000
TEST_ACCOUNT_SUPER_PASS_HASH=$2b$10$testhash
TEST_ACCOUNT_SUPER_NAME=瑞美管理员

# Bailian DeepSeek V4 Pro (server-side only)
DIAGNOSIS_AI_API_KEY=
DIAGNOSIS_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DIAGNOSIS_AI_MODEL=deepseek-v4-pro
