# Tandem · 环境变量模板
# 复制为 .env (dev) 或 .env.production (prod)，按用途填值

# ============================================================
# 核心
# ============================================================
NODE_ENV=development                          # development | production | test
LOG_LEVEL=info                                # debug | info | warn | error
APP_PORT=3000                                 # 容器对外端口

# ============================================================
# PostgreSQL (Drizzle ORM)
# ============================================================
DATABASE_URL=postgresql://tandem:tandem@localhost:5440/tandem
SHADOW_DATABASE_URL=postgresql://tandem:tandem@localhost:5440/tandem_shadow

# 搭子手抄独立数据库。未配置时继续使用 Tandem 主库中的现有手抄数据, 保持兼容。
SHOUCHAO_DATABASE_URL=
# Tandem 后台读取全部手抄数据的内部服务令牌。只给后端任务使用, 不放到浏览器。
SHOUCHAO_INTERNAL_TOKEN=
# 独立搭子手抄 App 远端地址。Tandem App 仍使用 TANDEM_MOBILE_SERVER_URL。
SHOUCHAO_MOBILE_SERVER_URL=http://10.0.2.2:3005/shouchao

# 隐私政策默认在牛马搭子 Web 管理后台 /admin/legal 编辑并保存到数据库。
# 下面两个变量仅作为外部 Markdown 兜底, 正常使用可以留空。
PRIVACY_POLICY_SOURCE_URL=
PRIVACY_POLICY_SOURCE_TIMEOUT_MS=5000

# 仅 prod 用 (docker-compose.prod.yml 注入)
POSTGRES_USER=tandem
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=tandem

# ============================================================
# Redis (session / rate-limit / cache)
# ============================================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ============================================================
# MinIO / S3 兼容对象存储 (Drive 文件)
# ============================================================
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=tandem
S3_SECRET_KEY=CHANGE_ME_STRONG_PASSWORD
S3_BUCKET_DRIVE=tandem-drive
S3_BUCKET_ATTACHMENTS=tandem-attachments
# 搭子手抄独立附件桶。未配置时仍回退 S3_BUCKET_ATTACHMENTS。
S3_BUCKET_SHOUCHAO_ATTACHMENTS=
S3_FORCE_PATH_STYLE=true

# ============================================================
# 语音转写 (STT / DashScope 千问 ASR 或 Whisper 兼容)
# ============================================================
# 启用后用于 Tandem 手抄与独立搭子手抄 APP「语音转笔记」。
# 千问 DashScope 按量计费示例:
# STT_PROVIDER=dashscope
# STT_MODEL=qwen3-asr-flash
# STT_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# STT_API_KEY=你的 DashScope API Key
STT_PROVIDER=none
STT_MODEL=qwen3-asr-flash
STT_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
STT_API_KEY=

# 图片识别 / 拍照记 OCR。未单独配置 OCR_* 时, 会自动复用 QWEN_API_KEY / QWEN_BASE_URL。
# 专门 OCR 推荐 qwen-vl-ocr; 通用视觉理解可改成 qwen3.6-flash / qwen3.7-plus 等支持图片输入的模型。
OCR_PROVIDER=openai
OCR_MODEL=qwen-vl-ocr
OCR_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
OCR_API_KEY=

MINIO_ROOT_USER=tandem
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ============================================================
# Auth / Session
# ============================================================
NEXTAUTH_SECRET=CHANGE_ME_LONG_RANDOM_HEX_64_CHARS

# 接口日志 (可选; 未配置时签名/哈希分别回落 NEXTAUTH_SECRET)
API_LOG_INGEST_SECRET=
API_LOG_IP_SALT=
API_LOG_BODY_MAX_BYTES=32768
API_LOG_MEMORY_MAX=5000
# 业务日志内存回退上限
BUSINESS_LOG_MEMORY_MAX=5000
NEXTAUTH_URL=http://localhost:3000
SESSION_TTL_SEC=604800                        # 7 天
ACCESS_TOKEN_TTL_SEC=900                      # 15 分钟
ALLOW_DEMO_AUTH=0                             # 1 = 允许 demo 用户跳过登录 (仅 dev)

# PLM / 创新匠台 SSO
# Tandem 点击 PLM 时会签发短期 JWT 并跳转到 PLM 的 /api/auth/sso/callback。
# 生产必须和 PLM 环境变量 TANDEM_SSO_JWT_SECRET 使用同一个强随机密钥。
PLM_STUDIO_URL=https://studio.rhautt.com
PLM_SSO_JWT_SECRET=CHANGE_ME_SHARED_RANDOM_SECRET_WITH_PLM

# 用友 ERP / iuap OpenAPI access_token
# YONYOU_ERP_BASE_URL 使用租户所在数据中心域名，例如 https://c1.yonyoucloud.com
YONYOU_ERP_BASE_URL=
YONYOU_ERP_APP_KEY=
YONYOU_ERP_APP_SECRET=
YONYOU_ERP_TOKEN_PATH=/iuap-api-auth/open-auth/selfAppAuth/base/v1/getAccessToken
YONYOU_ERP_TOKEN_TIMEOUT_MS=8000
YONYOU_ERP_THIRD_UC_ID=
YONYOU_ERP_TENANT_ID=
YONYOU_ERP_SSO_BASE_URL=https://euc.yonyoucloud.com
# 文档示例为 https://{data-center}/login?tenantId={tenantId}；配置 YONYOU_ERP_TENANT_ID 后会自动生成
YONYOU_ERP_LOGIN_SERVICE=
YONYOU_ERP_SSO_LOGIN_PATH=/cas/thirdOauth2CodeLogin
YONYOU_ERP_SSO_CODE_PATH=/iuap-api-gateway/yonbip/yht/getThirdLoginCode
YONYOU_ERP_SSO_TIMEOUT_MS=8000

# KPI 通道 B: 用友 YonSuite (YonBIP) 业绩数据拉取 (lib/kpi/erp-adapters/yonyou-kpi-adapter.ts)
# 复用上面的 YONYOU_ERP_BASE_URL/APP_KEY/APP_SECRET 鉴权。
# YONYOU_ERP_API_PREFIX 一般留空即可 (path 已含 /yonbip 前缀)。
YONYOU_ERP_API_PREFIX=
YONYOU_ERP_KPI_QUERY_TIMEOUT_MS=8000
# JSON 数组, 每个 subjectCode 对应一个 YonBIP 查询配置 (由 finance/IT 按贵司报表结构填写):
# [{"subjectCode":"REV-001","path":"/yonbip/fi/gl/...","method":"POST",
#   "body":{"org":"{{assigneeId}}"},"valueField":"data.records.0.balance",
#   "assigneeIds":["company"]}]
YONYOU_ERP_KPI_QUERY_MAP=

# Bcrypt cost (生产 ≥ 12)
BCRYPT_ROUNDS=12

# ============================================================
# 手机号 + 短信验证码 登录 (可选; 缺省=未配置, 登录页提示"待配置")
# ============================================================
# SMS_PROVIDER: none(默认) | log(dev: 验证码打到服务端日志, 不发真实短信) | aliyun | tencent
SMS_PROVIDER=none
# 接阿里云短信 (SMS_PROVIDER=aliyun 时, 在 lib/auth/sms-provider.ts 实现并填):
# SMS_ALIYUN_ACCESS_KEY_ID=
# SMS_ALIYUN_ACCESS_KEY_SECRET=
# SMS_ALIYUN_SIGN_NAME=
# SMS_ALIYUN_TEMPLATE_CODE=

# ============================================================
# 微信扫码登录 (可选; 缺 APP_ID/SECRET = 未配置, 登录页提示"待配置")
# 微信开放平台网站应用: https://open.weixin.qq.com
# ============================================================
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# WECHAT_REDIRECT_URI=http://localhost:3000/api/auth/wechat/callback

# MFA
MFA_REQUIRED_FOR_ROLES=admin,steward          # 这些角色强制 MFA

# ============================================================
# 公司域名白名单 — 员工自助注册 (无需邀请码)
# 多个域名用逗号分隔, 如: company.com,corp.example.com
# 留空 → 关闭自助注册路径 (员工只能通过邀请码进入)
# 配置示例: INTERNAL_EMAIL_DOMAINS=your-company.com
# ============================================================
INTERNAL_EMAIL_DOMAINS=

# ============================================================
# Owner bootstrap (首次启动自动创建公司主)
# 三个变量必须同时配置, 否则跳过. 部署后立即改密 + 启 MFA.
# ============================================================
TANDEM_BOOTSTRAP_OWNER_EMAIL=
TANDEM_BOOTSTRAP_OWNER_PASSWORD=
TANDEM_BOOTSTRAP_OWNER_NAME=Owner

# ============================================================
# Rate limiting
# ============================================================
RATE_LIMIT_LOGIN_PER_HOUR=5                   # /api/auth/login per IP per hour
RATE_LIMIT_API_PER_MINUTE=120                 # /api/* per user per minute

# ============================================================
# LLM Providers (按需启用)
# ============================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================
# Embedding 向量化 (语义召回的氧气)
# ------------------------------------------------------------
# 缺省 EMBEDDING_PROVIDER=none → baseline-guard / OKR drift / memory rerank 全部
# 降级到 Jaccard 字面匹配 (懂"客户数据严禁出境", 但"把信息传到境外服务器"这种同义改写
# 会漏)。配上任一 provider, 全链路判别力一次性升到语义级。lib/infra/embedding.ts 已就绪,
# 这是纯 ops 开关, 不需改代码。
#
# 选项 A · 本地 Ollama (免费, 民企无 API 预算首选; 需先 `ollama pull bge-m3`):
#   EMBEDDING_PROVIDER=ollama
#   EMBEDDING_MODEL=bge-m3
#   EMBEDDING_API_URL=http://localhost:11434/api/embeddings
#
# 选项 B · OpenAI 兼容云 (DeepSeek/OpenAI/通义等):
#   EMBEDDING_PROVIDER=openai
#   EMBEDDING_MODEL=text-embedding-3-small
#   EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
#   EMBEDDING_API_KEY=sk-...
#
# 配好后跑一次回填, 给历史 Memory 落库向量 (避免运行时 N+1 重算):
#   node scripts/backfill-embeddings.mjs
# ============================================================
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=
EMBEDDING_API_URL=
EMBEDDING_API_KEY=

# ============================================================
# 今日聚焦每日主动推送 (对标 WorkBoard Daily Focus)
# ------------------------------------------------------------
# 默认关闭。=1 时, boot 每日 (UTC 日期守卫) 给有紧急待办 (actNowCount>0) 的用户
# 主动推送一条"今日聚焦"通知 (应用内通知铃 + web-push, 不刷 IM)。
# 面向真实员工, 请在确认推送节奏/收件范围后再开启。
# ============================================================
DAILY_FOCUS_PUSH_ENABLED=0

# ============================================================
# 监控/观测 (可选)
# ============================================================
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ============================================================
# StratOS 战略感知桥 (中央 AI "战略之眼" · 可选)
# 中央 AI 通过 skill strategy.validity_digest 只读拉取 StratOS 战略合理性传感器。
# 两个值需与 StratOS 侧 STRATOS_PERCEPTION_TOKEN 一致; 未配置则该 skill 返回 ok:false (fail-soft)。
# ============================================================
STRATOS_PERCEPTION_URL=
STRATOS_PERCEPTION_TOKEN=

# 反向桥: StratOS 季度合理性复盘调 POST /api/company-brain/strategy-verdict 拿中央 AI 裁决建议。
# 值需与 StratOS 侧 HERMES_VERDICT_TOKEN 一致; 未配置则该端点返回 503 (未启用)。
STRATEGY_VERDICT_TOKEN=
