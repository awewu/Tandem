NODE_ENV=development
PORT=5500
API_PORT=5500
JWT_SECRET=local-dev-jwt-secret-change-me

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rhautt
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=rhautt_nexus
POSTGRES_SCHEMA=rhautt_nexus
POSTGRES_SYNCHRONIZE=false

MONGODB_URI=mongodb://localhost:27017/rysnova-hvac
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
CALC_ENGINE_URL=http://localhost:8200
NEXUS_PUBLIC_API_BASE=http://localhost:5500/api/v2

# Rhautt Nexus SSO OIDC local client.
# Copy this file to .env.nestjs and fill OIDC_CLIENT_SECRET from the IdP/secret channel.
OIDC_ISSUER=https://ai.rhautt.com
OIDC_CLIENT_ID=cli_mrvdz1yr8jfzrb8u
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5000/api/v2/auth/sso/callback
OIDC_SCOPES=openid profile email roles org
# /hub is the Nexus business landing page after login, not the OIDC callback URL.
OIDC_POST_LOGIN_REDIRECT=/hub
OIDC_USERINFO_ENABLED=true
OIDC_ALLOWED_REDIRECT_HOSTS=localhost:5000
OIDC_ROLES_CLAIM=roles
OIDC_ORG_CLAIM=org
