NODE_ENV=development
PORT=5500
API_PORT=5500
JWT_SECRET=local-dev-jwt-secret-change-me

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rhautt
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=rhautt_nexus
POSTGRES_SCHEMA=rhautt_nexus
POSTGRES_SYNCHRONIZE=false

MONGODB_URI=mongodb://localhost:27017/rysnova-hvac
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
# Public website image origin (server A). When configured, public site images
# uploaded through server B are mirrored to A before the API reports success.
SITE_MEDIA_ORIGIN_URL=https://www.everhot.com.cn
SITE_MEDIA_SYNC_URL=https://www.everhot.com.cn/internal/media-sync
SITE_MEDIA_SYNC_TOKEN=replace-with-a-long-random-shared-token
SITE_MEDIA_SYNC_TIMEOUT_MS=30000
CALC_ENGINE_URL=http://localhost:8200
NEXUS_PUBLIC_API_BASE=http://localhost:5500/api/v2

# Nexus Growth GEO -> Hermes center AI.
# Calls Hermes /api/llm-stream only; qwen-max is the currently healthy Hermes teamProvider.
# Switch HERMES_CENTER_AI_PROVIDER to gateway after /api/llm-health reports gateway healthy.
# HERMES_CENTER_AI_BASE_URL=https://ai.rhautt.com
# HERMES_CENTER_AI_PROVIDER=qwen-max
# HERMES_CENTER_AI_FIRST_BYTE_TIMEOUT_MS=30000
# HERMES_CENTER_AI_TIMEOUT_MS=120000
# HERMES_CENTER_AI_AUTH_HEADER=Authorization
# HERMES_CENTER_AI_AUTH_TOKEN=Bearer replace-with-hermes-token

# Rhautt Nexus SSO OIDC local client.
# Copy this file to .env.nestjs and fill OIDC_CLIENT_SECRET from the IdP/secret channel.
OIDC_ISSUER=https://ai.rhautt.com
OIDC_CLIENT_ID=cli_mrvdz1yr8jfzrb8u
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5000/api/v2/auth/sso/callback
OIDC_SCOPES=openid profile email roles org
# /hub is the Nexus business landing page after login, not the OIDC callback URL.
OIDC_POST_LOGIN_REDIRECT=/hub
OIDC_USERINFO_ENABLED=true
OIDC_ALLOWED_REDIRECT_HOSTS=localhost:5000
OIDC_ROLES_CLAIM=roles
OIDC_ORG_CLAIM=org
