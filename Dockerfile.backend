# ── Stage 1: 编译 TypeScript ─────────────────────────────────────────
FROM node:18-alpine AS builder
WORKDIR /app

RUN apk add --no-cache python3 make g++

COPY package*.json ./
RUN npm ci

COPY . .
RUN npx tsc -p services/api/tsconfig.json

# ── Stage 2: 生产运行镜像 ────────────────────────────────────────────
FROM node:18-alpine AS runtime
WORKDIR /app

RUN apk add --no-cache curl && \
    addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=builder /app/dist/services/api ./dist/services/api
COPY --from=builder /app/services/api/src   ./services/api/src

RUN mkdir -p uploads logs && chown -R nodejs:nodejs /app
USER nodejs

EXPOSE 3300
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:3300/api/v2/health || exit 1

CMD ["node", "dist/services/api/main.js"]
